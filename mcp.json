{
  "mcpServers": {
    "CodeGraphContext": {
      "command": "~/miniconda3/envs/jupyter/bin/cgc",
      "args": [
        "mcp",
        "start"
      ],
      "env": {
        "DEFAULT_DATABASE": "falkordb",
        "FALKORDB_PATH": "~/.codegraphcontext/global/db/falkordb",
        "FALKORDB_SOCKET_PATH": "~/.codegraphcontext/global/db/falkordb.sock",
        "INDEX_VARIABLES": "true",
        "ALLOW_DB_DELETION": "false",
        "DEBUG_LOGS": "false",
        "DEBUG_LOG_PATH": "~/mcp_debug.log",
        "ENABLE_APP_LOGS": "CRITICAL",
        "LIBRARY_LOG_LEVEL": "WARNING",
        "LOG_FILE_PATH": "~/.codegraphcontext/logs/cgc.log",
        "MAX_FILE_SIZE_MB": "10",
        "IGNORE_TEST_FILES": "false",
        "IGNORE_HIDDEN_FILES": "true",
        "ENABLE_AUTO_WATCH": "false",
        "COMPLEXITY_THRESHOLD": "10",
        "MAX_DEPTH": "unlimited",
        "PARALLEL_WORKERS": "4",
        "CACHE_ENABLED": "true",
        "IGNORE_DIRS": "node_modules,venv,.venv,env,.env,dist,build,target,out,.git,.idea,.vscode,__pycache__",
        "INDEX_SOURCE": "true",
        "SCIP_INDEXER": "false",
        "SCIP_LANGUAGES": "python,typescript,go,rust,java",
        "SKIP_EXTERNAL_RESOLUTION": "false"
      },
      "tools": {
        "disabledTools": ["add_code_to_graph", "add_package_to_graph", "list_indexed_repositories", "delete_repository", "get_repository_stats", "load_bundle", "search_registry_bundles",
          "watch_directory", "list_watched_paths", "unwatch_directory", "check_job_status", "list_jobs", "visualize_graph_query", "find_most_complex_functions", "switch_context",
          "find_java_spring_beans", "find_java_spring_endpoints", "generate_report", "find_datasource_nodes", "find_code"],
        "alwaysAllow": [
          "analyze_code_relationships",
          "calculate_cyclomatic_complexity",
          "discover_codegraph_contexts",
          "execute_cypher_query",
          "find_dead_code",
          "find_most_complex_functions"
        ],
        "disabled": false
      },
      "disabled": false,
      "alwaysAllow": []
    }
  }
}